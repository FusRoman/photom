#!/bin/sh

# Feature sets to check for clippy and cargo check.
# The empty string represents the no-features build.
FEATURE_SETS="
 
polars
parallel
ades
mpc_80_col
datafusion
polars,parallel
polars,ades
polars,mpc_80_col
polars,datafusion
parallel,ades
parallel,mpc_80_col
parallel,datafusion
ades,mpc_80_col
ades,datafusion
mpc_80_col,datafusion
polars,parallel,ades
polars,parallel,mpc_80_col
polars,parallel,datafusion
polars,ades,mpc_80_col
polars,ades,datafusion
polars,mpc_80_col,datafusion
parallel,ades,mpc_80_col
parallel,ades,datafusion
parallel,mpc_80_col,datafusion
ades,mpc_80_col,datafusion
polars,parallel,ades,mpc_80_col
polars,parallel,ades,datafusion
polars,parallel,mpc_80_col,datafusion
polars,ades,mpc_80_col,datafusion
parallel,ades,mpc_80_col,datafusion
polars,parallel,ades,mpc_80_col,datafusion
"

# ---------------------------------------------------------------------------
# 1. Format check (feature-independent)
# ---------------------------------------------------------------------------
echo "==> cargo fmt --check"
cargo fmt --all -- --check || exit 1

# ---------------------------------------------------------------------------
# 2. clippy + check for every feature combination
# ---------------------------------------------------------------------------
for features in $FEATURE_SETS; do
    if [ -z "$features" ]; then
        label="(no features)"
        flag="--no-default-features"
    else
        label="--features $features"
        flag="--no-default-features --features $features"
    fi

    echo ""
    echo "==> cargo clippy  [$label]"
    # shellcheck disable=SC2086
    cargo clippy --all-targets $flag -- -D warnings || exit 1

    echo "==> cargo check   [$label]"
    # shellcheck disable=SC2086
    cargo check --all-targets $flag || exit 1
done

# ---------------------------------------------------------------------------
# 3. Documentation — all features only
#    rustdoc resolves cross-feature intra-doc links only when every referenced
#    item is compiled, so running with a partial feature set would produce
#    spurious "unresolved link" errors for feature-gated public items.
# ---------------------------------------------------------------------------
echo ""
echo "==> cargo doc [--all-features]"
RUSTDOCFLAGS="-D warnings --html-in-header $(pwd)/katex-header.html" \
    cargo doc --no-deps --all-features || exit 1

echo ""
echo "All checks passed."
